---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getNotes, fmtDate, type Note } from '../../lib/content';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

interface Props { note: Note }
const { note } = Astro.props;
const { Content } = await render(note);
const d = note.data;
const description = (note.body ?? '').replace(/https?:\/\/\S+/g, '').replace(/[*_`#>]/g, '').replace(/\s+/g, ' ').trim().slice(0, 155);
---
<Base title={d.title} description={description} type="article" publishedTime={d.date}>
  <article>
    <header class="article-header">
      <p class="page-cmd"><span class="ps1">$</span> cat ~/notes/{note.id}.md</p>
      <h1>{d.title}</h1>
      <div class="meta">
        {d.draft && <span class="badge-draft">draft</span>}
        <time datetime={fmtDate(d.date, 'iso')}>{fmtDate(d.date)}</time>
        {d.highlight && <span class="badge-hl">{d.highlight}</span>}
        {d.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>
    <div class="prose"><Content /></div>
    <footer class="article-footer">
      {d.linkedin && (
        <p class="provenance">First posted on <a href={d.linkedin} target="_blank" rel="noopener">LinkedIn</a>, where the discussion lives.</p>
      )}
      <p class="provenance"><a href="/notes/">← all notes</a></p>
    </footer>
  </article>
</Base>
