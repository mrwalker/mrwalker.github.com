---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import MahalCard from '../../components/MahalCard.astro';
import { getWriting, fmtDate, readingTime, type Post } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getWriting();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

interface Props { post: Post; all: Post[] }
const { post, all } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const series = d.series
  ? all.filter((p) => p.data.series === d.series).sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];
const idx = all.findIndex((p) => p.id === post.id);
const newer = idx > 0 ? all[idx - 1] : undefined;
const older = idx < all.length - 1 ? all[idx + 1] : undefined;
---
<Base title={d.title} description={d.description} canonical={d.canonical} image={d.cover} type="article" publishedTime={d.date}>
  <article>
    <header class="article-header">
      <p class="page-cmd"><span class="ps1">$</span> cat ~/writing/{post.id}.md</p>
      <h1>{d.title}</h1>
      <p class="desc">{d.description}</p>
      <div class="meta">
        {d.draft && <span class="badge-draft">draft: not published</span>}
        <time datetime={fmtDate(d.date, 'iso')}>{fmtDate(d.date)}</time>
        <span>· {readingTime(post.body)}</span>
        {d.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>

    {d.cover && <img class={`article-cover fit-${d.coverFit}`} src={d.cover} alt="" style={d.coverPosition ? `object-position: ${d.coverPosition}` : undefined} />}

    {series.length > 1 && (
      <div class="series-box">
        Part of <strong>{d.series}</strong>
        <ol>
          {series.map((p) => (
            <li>{p.id === post.id ? <span class="current">{p.data.title}</span> : <a href={`/writing/${p.id}/`}>{p.data.title}</a>}</li>
          ))}
        </ol>
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    <footer class="article-footer">
      {(d.mirrorUrl || d.canonical) && (
        <p class="provenance">
          {d.canonical
            ? <>Originally published on <a href={d.canonical} target="_blank" rel="noopener">{d.mirrorName ?? 'another site'}</a>.</>
            : <>Also on <a href={d.mirrorUrl} target="_blank" rel="noopener">{d.mirrorName}</a>.</>}
          {' '}Written while CTO at Simon AI.
        </p>
      )}
      <MahalCard compact />
      <nav class="pager" aria-label="More writing">
        {older && <a class="prev" href={`/writing/${older.id}/`}><span>← older</span>{older.data.title}</a>}
        {newer && <a class="next" href={`/writing/${newer.id}/`}><span>newer →</span>{newer.data.title}</a>}
      </nav>
    </footer>
  </article>
</Base>
