---
import Base from '../../layouts/Base.astro';
import { getWriting, fmtDate, readingTime } from '../../lib/content';

const posts = await getWriting();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const years = [...new Set(posts.map((p) => p.data.date.getUTCFullYear()))].sort((a, b) => b - a);
---
<Base title="Writing" description="Long-form writing by Matt Walker on AI agents, evals, semantic layers, and composable data architecture.">
  <p class="page-cmd"><span class="ps1">$</span> ls -lt ~/writing</p>
  <h1 class="section-title">Writing</h1>
  <p class="lede">
    Long-form posts on building agents that hold up in production, and the data architecture underneath them.
    This site is their permanent home; some also appear on Medium.
  </p>

  <div class="filters" role="group" aria-label="Filter by tag">
    <button type="button" data-tag="" aria-pressed="true">all</button>
    {tags.map((t) => <button type="button" data-tag={t} aria-pressed="false">{t}</button>)}
  </div>

  {years.map((y) => (
    <div class="year-group" data-year={y}>
      <div class="year-label">{y}</div>
      <ul class="entries">
        {posts.filter((p) => p.data.date.getUTCFullYear() === y).map((p) => (
          <li class="entry" data-tags={p.data.tags.join('|')}>
            <time class="when" datetime={fmtDate(p.data.date, 'iso')}>{fmtDate(p.data.date, 'short').replace(/, \d{4}$/, '')}</time>
            <div>
              <h3><a href={`/writing/${p.id}/`}>{p.data.title}</a></h3>
              <p>{p.data.description}</p>
              <div class="meta">
                {p.data.draft && <span class="badge-draft">draft</span>}
                <span>{readingTime(p.body)}</span>
                {p.data.series && <span>· {p.data.series}</span>}
                {p.data.tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  ))}

  <div class="year-group">
    <div class="year-label">elsewhere</div>
    <ul class="entries">
      <li class="entry">
        <span class="when">2022</span>
        <div>
          <h3><a href="https://solutionsreview.com/marketing-automation/using-in-house-data-to-deliver-better-marketing-personalization/" target="_blank" rel="noopener">Using In-House Data to Deliver Better Marketing Personalization</a></h3>
          <p>Byline in Solutions Review.</p>
        </div>
      </li>
      <li class="entry">
        <span class="when">now</span>
        <div>
          <h3><a href="https://mahalsystems.ai/research/" target="_blank" rel="noopener">Mahal Systems research</a></h3>
          <p>Agent evals, model upgrades, and optimization, from the Mahal team.</p>
        </div>
      </li>
      <li class="entry">
        <span class="when">older</span>
        <div>
          <h3><a href="/papers/">Papers</a></h3>
          <p>KDD '09 and Java Developer's Journal, from the multi-core dataflow era.</p>
        </div>
      </li>
    </ul>
  </div>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag ?? '';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        document.querySelectorAll<HTMLElement>('.year-group[data-year]').forEach((group) => {
          let visible = 0;
          group.querySelectorAll<HTMLElement>('.entry').forEach((li) => {
            const show = !tag || (li.dataset.tags ?? '').split('|').includes(tag);
            li.hidden = !show;
            if (show) visible++;
          });
          group.hidden = visible === 0;
        });
      }),
    );
  </script>
</Base>
