---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
}
const { title, description = SITE.description, canonical, image = '/images/avatar.png', type = 'website', publishedTime } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.role}`;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const imageURL = new URL(image, Astro.site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Matt Walker',
  url: SITE.url,
  jobTitle: 'Co-founder',
  worksFor: { '@type': 'Organization', name: 'Mahal Systems', url: 'https://mahalsystems.ai/' },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'The University of Texas at Austin' },
    { '@type': 'CollegeOrUniversity', name: 'Rice University' },
  ],
  sameAs: ['https://www.linkedin.com/in/mwalker', 'https://github.com/mrwalker', 'https://medium.com/@data_daddy', 'https://twitter.com/data_daddy'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/avatar.png" />
    <link rel="alternate" type="application/rss+xml" title="Matt Walker: writing & notes" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a0e1a" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:site_name" content={SITE.name} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content={image === '/images/avatar.png' ? 'summary' : 'summary_large_image'} />
    <meta name="twitter:creator" content="@data_daddy" />

    {Astro.url.pathname === '/' && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="background-grid" aria-hidden="true"></div>
    <div class="wrapper">
      <Sidebar />
      <main id="main">
        <slot />
      </main>
      <footer class="site-footer">
        <span>© {new Date().getFullYear()} Matt Walker</span><span class="sep">//</span>
        <span>Built with Claude's help</span><span class="sep">//</span>
        <a href="/rss.xml">rss</a><span class="sep">·</span>
        <a href="/llms.txt">llms.txt</a><span class="sep">·</span>
        <a href="https://github.com/mrwalker/mrwalker.github.com" target="_blank" rel="noopener">source</a>
      </footer>
    </div>
    <script is:inline>
      console.log('%c$ whoami\n%cMatt Walker: agent developer, co-founder of Mahal Systems.\nCurious how this site works? curl https://mwalker.info/llms.txt', 'color:#34d399;font-family:monospace;font-weight:bold', 'color:#94a3b8;font-family:monospace');
    </script>
  </body>
</html>
