// Cloudflare Workers static-assets deploy for mwalker.info.
// Build: `pnpm build` -> ./dist ; Deploy: `pnpm run deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mwalker-info",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Zone route on the proxied apex: the Worker answers before the old GitHub Pages origin is ever reached.
  // hub.mwalker.info and other subdomains are untouched.
  "routes": [
    { "pattern": "mwalker.info/*", "zone_name": "mwalker.info" }
  ]
}
